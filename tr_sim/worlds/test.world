<?xml version="1.0" ?>
<sdf version='1.6'>
    <world name='default'>
        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose frame=''>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>100</mu>
                                <mu2>50</mu2>
                            </ode>
                            <torsional>
                                <ode/>
                            </torsional>
                        </friction>
                        <contact>
                            <ode/>
                        </contact>
                        <bounce/>
                    </surface>
                    <max_contacts>10</max_contacts>
                </collision>
                <visual name='visual'>
                    <cast_shadows>0</cast_shadows>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                    </material>
                </visual>
                <self_collide>0</self_collide>
                <enable_wind>0</enable_wind>
                <kinematic>0</kinematic>
            </link>
        </model>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type='adiabatic'/>
        <physics name='default_physics' default='0' type='ode'>
            <max_step_size>0.01</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>100</real_time_update_rate>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>100</iters>
                    <precon_iters>0</precon_iters>
                    <sor>1</sor>
                    <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>0</cfm>
                    <erp>0.5</erp>
                    <contact_max_correcting_vel>1000</contact_max_correcting_vel>
                    <contact_surface_layer>0</contact_surface_layer>
                </constraints>
            </ode>
        </physics>
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>1</shadows>
        </scene>
        <audio>
            <device>default</device>
        </audio>
        <wind/>
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>0</latitude_deg>
            <longitude_deg>0</longitude_deg>
            <elevation>0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <include>
            <name>bottom_wall_1</name>
            <uri>model://jersey_barrier</uri>
            <pose>-1.5 0.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>bottom_wall_2</name>
            <uri>model://jersey_barrier</uri>
            <pose>-1.5 -3.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>bottom_wall_3</name>
            <uri>model://jersey_barrier</uri>
            <pose>-1.5 -7.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>top_wall_1</name>
            <uri>model://jersey_barrier</uri>
            <pose>3.5 0.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>top_wall_2</name>
            <uri>model://jersey_barrier</uri>
            <pose>3.5 -3.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>top_wall_3</name>
            <uri>model://jersey_barrier</uri>
            <pose>3.5 -7.5 0 0 0 1.5708</pose>
            <static>true</static>
        </include>
        <include>
            <name>left_wall</name>
            <uri>model://jersey_barrier</uri>
            <pose>1 3 0 0 0 0</pose>
            <static>true</static>
        </include>
        <include>
            <name>right_wall</name>
            <uri>model://jersey_barrier</uri>
            <pose>1 -10 0 0 0 0</pose>
            <static>true</static>
        </include>

        <include>
            <name>cone_bottom_left</name>
            <uri>model://construction_cone</uri>
            <pose>-0.5 2 0 0 0 0</pose>
            <static>true</static>
        </include>
        <include>
            <name>cone_bottom_right</name>
            <uri>model://construction_cone</uri>
            <pose>-0.5 -9 0 0 0 0</pose>
            <static>true</static>
        </include>
        <include>
            <name>cone_top_left</name>
            <uri>model://construction_cone</uri>
            <pose>2.5 2 0 0 0 0</pose>
            <static>true</static>
        </include>
        <include>
            <name>cone_top_right</name>
            <uri>model://construction_cone</uri>
            <pose>2.5 -9 0 0 0 0</pose>
            <static>true</static>
        </include>

    </world>
</sdf>